import { neon } from "@neondatabase/serverless";

const sql = neon(process.env.DATABASE_URL);

function authorized(req) {
    const supplied = String(req.headers["x-admin-password"] || "");
    const expected = String(process.env.SURVEY_ADMIN_PASSWORD || "");
    return expected && supplied === expected;
}

export default async function handler(req, res) {
    if (!authorized(req)) {
        return res.status(401).json({
            success: false,
            message: "Invalid admin password"
        });
    }

    try {
        if (req.method !== "GET") {
            return res.status(405).json({
                success: false,
                message: "Method not allowed"
            });
        }

        const from = String(req.query.from || "").trim();
        const to = String(req.query.to || "").trim();

        const surveys = await sql`
            SELECT
                id,
                flight_number,
                destination,
                airline,
                access_type,
                average_rating,
                overall_rating,
                recommendation_score,
                liked_most,
                improvement,
                comments,
                submitted_at
            FROM lounge_surveys
            WHERE
                (${from || null}::date IS NULL OR submitted_at >= ${from || null}::date)
                AND
                (${to || null}::date IS NULL OR submitted_at < (${to || null}::date + INTERVAL '1 day'))
            ORDER BY submitted_at DESC
            LIMIT 2000
        `;

        const summaryRows = await sql`
            SELECT
                COUNT(*)::int AS total_responses,
                ROUND(AVG(overall_rating)::numeric, 2) AS overall_average,
                ROUND(AVG(average_rating)::numeric, 2) AS question_average,
                ROUND(AVG(recommendation_score)::numeric, 2) AS nps_average,
                COUNT(*) FILTER (WHERE recommendation_score >= 9)::int AS promoters,
                COUNT(*) FILTER (WHERE recommendation_score BETWEEN 7 AND 8)::int AS passives,
                COUNT(*) FILTER (WHERE recommendation_score <= 6)::int AS detractors
            FROM lounge_surveys
            WHERE
                (${from || null}::date IS NULL OR submitted_at >= ${from || null}::date)
                AND
                (${to || null}::date IS NULL OR submitted_at < (${to || null}::date + INTERVAL '1 day'))
        `;

        const questionStats = await sql`
            SELECT
                a.question_key,
                MAX(a.question_title) AS title,
                ROUND(AVG(a.rating)::numeric, 2) AS average_rating,
                COUNT(*)::int AS responses,
                COUNT(*) FILTER (WHERE a.rating = 5)::int AS excellent,
                COUNT(*) FILTER (WHERE a.rating = 4)::int AS good,
                COUNT(*) FILTER (WHERE a.rating = 3)::int AS average,
                COUNT(*) FILTER (WHERE a.rating = 2)::int AS poor,
                COUNT(*) FILTER (WHERE a.rating = 1)::int AS very_poor
            FROM lounge_survey_answers a
            JOIN lounge_surveys s
              ON s.id = a.survey_id
            WHERE
                (${from || null}::date IS NULL OR s.submitted_at >= ${from || null}::date)
                AND
                (${to || null}::date IS NULL OR s.submitted_at < (${to || null}::date + INTERVAL '1 day'))
            GROUP BY a.question_key
            ORDER BY average_rating DESC, title ASC
        `;

        const summary = summaryRows[0] || {};
        const total = Number(summary.total_responses || 0);
        const promoters = Number(summary.promoters || 0);
        const detractors = Number(summary.detractors || 0);

        const nps = total
            ? Math.round(((promoters - detractors) / total) * 100)
            : 0;

        return res.status(200).json({
            success: true,
            summary: {
                ...summary,
                nps
            },
            questionStats,
            surveys
        });

    } catch (error) {
        console.error("Results load error:", error);

        return res.status(500).json({
            success: false,
            message: "Unable to load results"
        });
    }
}